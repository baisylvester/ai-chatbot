# Copy to apps/dashboard/.env.local (and the repo root .env for scripts). Never commit real values.

# Neon Postgres (server-only). Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional: a throwaway database (e.g. a Neon branch) for the RLS integration tests.
TEST_DATABASE_URL=

# Platform
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# AI providers (server-side only; never exposed to widgets or browsers). Set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
# OpenAI-compatible server (Ollama, vLLM, LM Studio, or tools/mock-openai-server.mjs at http://localhost:4010/v1)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Neon AI Gateway (needs prepaid AI Gateway credits)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Neon Auth (written by `neon env pull`; generate the cookie secret yourself, 32+ chars)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
