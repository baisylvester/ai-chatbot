# Copy to apps/dashboard/.env.local (and the repo root .env for scripts). Never commit real values.

# Supabase Postgres (server-only). Supabase dashboard > Connect.
# DATABASE_URL: "Transaction pooler" (port 6543) for the app. DATABASE_URL_UNPOOLED: "Session pooler" (port 5432) for migrations.
# Supabase hosts are verified against the bundled Supabase root CA. DATABASE_CA_CERT (PEM) overrides it for any host.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional: a throwaway database (a separate Supabase project or a local Postgres with pgvector) for the RLS integration tests.
TEST_DATABASE_URL=

# Platform
# Production: the public https URL, a random CRON_SECRET (32+ chars) for /api/internal/maintenance.
CRON_SECRET=
# Optional tuning: DATABASE_POOL_MAX (default 10), RATE_LIMIT_STORE=memory (single server/tests only),
# REALTIME_DAILY_MINUTES (realtime voice budget per organization per day, default 120).
# Signs widget session tokens. Required; 32+ random characters (e.g. `openssl rand -base64 48`).
EMBED_TOKEN_SECRET=
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000

# AI providers (server-side only; never exposed to widgets or browsers). Set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
# OpenAI-compatible server (Ollama, vLLM, LM Studio, or tools/mock-openai-server.mjs at http://localhost:4010/v1)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Voice (speech-to-text / text-to-speech / realtime). OpenAI voice uses OPENAI_API_KEY above.
ELEVENLABS_API_KEY=
# Optional model overrides: OPENAI_STT_MODEL, OPENAI_TTS_MODEL, ELEVENLABS_STT_MODEL, ELEVENLABS_TTS_MODEL
# Development only: VOICE_MOCK=1 enables a mock voice provider.

# Embeddings for the knowledge base: openai | gemini | neon-gateway | mock (dev only). Defaults to the first configured.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
# Neon AI Gateway (needs prepaid AI Gateway credits)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Supabase Auth (Project Settings > API Keys): project URL and publishable key. Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
